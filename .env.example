APP_NAME=Craft
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en

# Signs session cookies. Generate one with: python dev.py key:generate
# Without it the framework falls back to a random per-process key, so sessions
# do not survive a restart and are not shared between workers.
APP_KEY=

# Database — sqlite | pgsql | mysql
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=craft
DB_USERNAME=postgres
DB_PASSWORD=secret

# Session — cookie (payload in a signed cookie) | file (payload on disk)
SESSION_DRIVER=cookie
SESSION_LIFETIME=7200
SESSION_COOKIE=craft_session
SESSION_SAME_SITE=lax
# Turn this on in production so the cookie is HTTPS-only.
SESSION_SECURE_COOKIE=false
# Only disable for a fully stateless API.
SESSION_CSRF=true

# Cache — array | file | redis
CACHE_DRIVER=array

# Queue — sync (run inline) | database
QUEUE_CONNECTION=sync

# Redis (only needed for CACHE_DRIVER=redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
