# Multi-stage production Dockerfile for the Craft framework

# --- Stage 1: Builder ---
FROM python:3.11-slim as builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY README.md .
COPY services/ ./services/

RUN pip install --no-cache-dir --prefix=/install . \
    && pip install --no-cache-dir --prefix=/install uvicorn[standard] gunicorn psycopg[binary]

# --- Stage 2: Production Final Image ---
FROM python:3.11-slim as production

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    APP_ENV=production \
    APP_DEBUG=false

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed dependencies from builder
COPY --from=builder /install /usr/local

# Copy application codebase
COPY . .

# Ensure storage and bootstrap/cache permissions
RUN mkdir -p storage/app/public storage/framework/cache storage/framework/sessions storage/logs \
    && chmod -R 775 storage bootstrap/cache 2>/dev/null || true

# Create non-root system user for production security
RUN addgroup --system dev && adduser --system --group dev \
    && chown -R dev:dev /app

USER dev

EXPOSE 8000

# Production Entrypoint: apply pending migrations only (never `migrate fresh`,
# which drops data), then run Gunicorn with Uvicorn ASGI Workers pointing to
# public.index:application.
CMD ["sh", "-c", "python dev.py migrate && gunicorn -w 4 -k uvicorn.workers.UvicornWorker public.index:application --bind 0.0.0.0:8000"]
